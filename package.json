{
  "name": "react-native-clamshell",
  "version": "0.1.0",
  "description": "react-native-clamshell is a react native package built with Nitro",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "yarn typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && yarn build && node post-script.js",
    "pod": "yarn workspace react-native-clamshell-example pod",
    "test:js": "jest --config jest.config.js --runInBand --no-watchman",
    "test:android": "./example/android/gradlew -p example/android :react-native-clamshell:testDebugUnitTest --no-daemon",
    "test:ios": "yarn pod && ./scripts/run-ios-tests.sh",
    "test:worklet:android": "./scripts/run-worklet-harness.sh android",
    "test:worklet:ios": "./scripts/run-worklet-harness.sh ios",
    "test:worklets:android": "yarn test:worklet:android",
    "test:worklets:ios": "yarn test:worklet:ios",
    "check:generated": "yarn codegen && git diff --exit-code -- . ':!example/ios/Podfile.lock'",
    "check:package": "node scripts/check-package-contents.mjs",
    "build:android:debug": "./example/android/gradlew -p example/android :app:assembleDebug --no-daemon",
    "build:android:release": "./example/android/gradlew -p example/android :app:assembleRelease --no-daemon",
    "build:ios": "yarn pod && ./scripts/build-ios.sh"
  },
  "keywords": [
    "react-native",
    "react-native-clamshell"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "docs/api.md",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/stefanilie/react-native-clamshell.git",
  "author": "Stefan Ilie",
  "license": "MIT",
  "bugs": "https://github.com/stefanilie/react-native-clamshell/issues",
  "homepage": "https://github.com/stefanilie/react-native-clamshell#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-jest": "30.5.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "30.5.1",
    "nitrogen": "0.37.1",
    "prettier": "3.3.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.6.0",
    "react-native-worklets": "0.12.2",
    "react-test-renderer": "19.2.3",
    "semantic-release": "^25.0.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.6.0",
    "react-native-worklets": "0.12.2"
  },
  "packageManager": "yarn@4.9.2",
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
